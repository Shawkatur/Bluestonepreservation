# Bluestone Home Solutions LLC — Environment Variables
# Copy this file to .env.local and fill in the values

# Resend API key for contact form email delivery
# Get yours at https://resend.com
RESEND_API_KEY=

# Email address to receive form submissions
CONTACT_EMAIL=service@bluestonehomellc.com

# Site URL (used for SEO and sitemap)
NEXT_PUBLIC_SITE_URL=https://bluestonehomellc.com

# Google Maps Embed API key (optional, for interactive map)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
